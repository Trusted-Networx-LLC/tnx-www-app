{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://trustednetworx.com",
  "scripts": {
    "dev": "vite",
    "generate:seo": "node scripts/generate-rss.cjs && node scripts/generate-sitemap.cjs",
    "prebuild": "npm run generate:seo",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.cjs",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "port": 45789,
    "include": [
      "/",
      "/about",
      "/about/team",
      "/pots-replacement",
      "/ai-consulting",
      "/internet-connectivity",
      "/mobility-solutions",
      "/voice-solutions",
      "/ai-workforce",
      "/contact",
      "/blog",
      "/tools",
      "/tools/pots-roi-calculator",
      "/tools/copper-sunset-risk",
      "/tools/failover-readiness",
      "/tools/ai-roi-calculator",
      "/tools/ai-readiness",
      "/platforms/partner-hub",
      "/platforms/crm",
      "/partners",
      "/ai"
    ],
    "skipThirdPartyRequests": true,
    "inlineCss": false,
    "waitFor": "html[data-seo-ready]",
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    }
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.35",
    "puppeteer": "25.3.0",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
